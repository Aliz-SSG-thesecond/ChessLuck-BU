<!DOCTYPE html>
<html lang="en">
<head>
    <%- include ('../partials/messages.ejs')-%>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chess Deck Selection</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,450;0,9..144,600;0,9..144,700;1,9..144,450&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --parchment: #F2E8D0;
            --parchment-deep: #E7D8B0;
            --parchment-line: #C9B786;
            --walnut: #3B2A1E;
            --walnut-soft: #6E5643;
            --ink: #211508;
            --brass: #A9812C;
            --brass-bright: #C9A227;
            --forest: #445640;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Spectral', Georgia, serif;
        }

        .font-display { font-family: 'Fraunces', serif; }
        .font-utility { font-family: 'Inter', sans-serif; }

        body {
            background-color: var(--parchment);
            background-image: radial-gradient(circle at 1px 1px, rgba(59,42,30,0.07) 1px, transparent 0);
            background-size: 22px 22px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            color: var(--ink);
        }

        .header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .header .eyebrow {
            font-family: 'Inter', sans-serif;
            font-size: 0.72rem;
            letter-spacing: 0.24em;
            text-transform: uppercase;
            color: var(--brass);
            margin-bottom: 0.6rem;
        }

        .header h1 {
            font-family: 'Fraunces', serif;
            font-size: 2.35rem;
            font-weight: 600;
            color: var(--walnut);
            letter-spacing: -0.01em;
            margin-bottom: 0.5rem;
        }

        .subtitle {
            font-family: 'Spectral', serif;
            font-size: 1.05rem;
            color: var(--walnut-soft);
            font-weight: 400;
        }

        .decks-container {
            display: flex;
            gap: 2rem;
            margin-bottom: 3rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .deck-card {
            background: var(--parchment-deep);
            border-radius: 4px;
            padding: 2rem;
            width: 280px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid var(--parchment-line);
            box-shadow: 0 4px 20px rgba(33, 21, 8, 0.08);
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .deck-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 12px 30px rgba(33, 21, 8, 0.15);
        }

        .deck-card.selected {
            border-color: var(--brass);
            box-shadow: 0 8px 25px rgba(169, 129, 44, 0.25);
            transform: translateY(-8px) scale(1.02);
        }

        .deck-card.selected::before {
            content: '';
            position: absolute;
            top: -8px;
            right: -8px;
            width: 24px;
            height: 24px;
            background: var(--brass);
            border-radius: 50%;
            border: 3px solid var(--parchment);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .deck-card.selected::after {
            content: '✓';
            position: absolute;
            top: -4px;
            right: 2px;
            color: var(--parchment);
            font-size: 14px;
            font-weight: bold;
            font-family: 'Inter', sans-serif;
        }

        .deck-preview {
            display: flex;
            gap: 0.75rem;
            margin: 1.5rem 0;
            flex-wrap: wrap;
            justify-content: center;
        }

        .piece {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            background: var(--brass);
            border-radius: 4px;
            transition: transform 0.2s ease;
        }

        .piece:hover {
            transform: scale(1.1);
        }

        .deck-info {
            text-align: center;
        }

        .deck-name {
            font-family: 'Fraunces', serif;
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--walnut);
            margin-bottom: 0.5rem;
        }

        .deck-description {
            font-family: 'Spectral', serif;
            font-size: 0.95rem;
            color: var(--walnut-soft);
            line-height: 1.4;
        }

        .confirm-button {
            background: var(--walnut);
            color: var(--parchment);
            border: 1px solid var(--walnut);
            border-radius: 2px;
            padding: 1rem 2.75rem;
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            letter-spacing: 0.02em;
            cursor: not-allowed;
            opacity: 0.45;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(33, 21, 8, 0.1);
        }

        .confirm-button.enabled {
            background: var(--walnut);
            opacity: 1;
            cursor: pointer;
            box-shadow: 0 8px 25px rgba(169, 129, 44, 0.3);
        }

        .confirm-button.enabled:hover {
            background: var(--brass);
            border-color: var(--brass);
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(169, 129, 44, 0.35);
        }

        .confirm-button.enabled:active {
            transform: translateY(0);
        }

        .status-text {
            margin-top: 1.5rem;
            color: var(--walnut-soft);
            font-family: 'Fraunces', serif;
            font-style: italic;
            font-size: 1rem;
            text-align: center;
        }

        @media (max-width: 768px) {
            .decks-container {
                flex-direction: column;
                align-items: center;
            }
            
            .header h1 {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="eyebrow">Before You Play</div>
        <h1>Select Your Deck</h1>
        <p class="subtitle">Choose a chess piece set for your game</p>
    </div>
    <div class="decks-container">
            <% decks.forEach(deck => { %>
                <div class="deck-card" data-deck="<%= deck._id %>">
                    <div class="deck-info">
                        <h2 class="deck-name"><%= deck.name %></h2>
                        <p class="deck-description"><%= deck.description || 'Custom deck' %></p>
                    </div>
                    <!-- <div class="deck-preview">
                        <% deck.pieces.forEach(piece => { %>
                            <div class="piece"><%= piece %></div>
                        <% }) %>
                    </div> -->
                </div>
            <% }) %>
        </div>
        

    <button class="confirm-button" id="confirmBtn">Confirm Selection</button>
    <p class="status-text" id="statusText">Both players must select their decks to continue</p>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const socket = io();
            // Register user to receive events
            <% if (typeof currentUserId !== 'undefined') { %>
            socket.emit('registerUser', '<%= currentUserId %>');
            <% } %>

            // If both decks selected anywhere, redirect to game page
            socket.on('bothDecksSelected', function(data) {
                if (data && data.gameId) {
                    window.location.href = `/game/${data.gameId}`;
                }
            });

            const deckCards = document.querySelectorAll('.deck-card');
            const confirmBtn = document.getElementById('confirmBtn');
            const statusText = document.getElementById('statusText');
            let selectedDeck = null;

            deckCards.forEach(card => {
                card.addEventListener('click', function() {
                    // Remove selection from all cards
                    deckCards.forEach(c => c.classList.remove('selected'));
                    
                    // Add selection to clicked card
                    this.classList.add('selected');
                    
                    // Update selected deck
                    selectedDeck = this.dataset.deck;
                    
                    // Enable confirm button
                    confirmBtn.classList.add('enabled');
                    confirmBtn.disabled = false;
                });

                // Add hover effect
                card.addEventListener('mouseenter', function() {
                    if (!this.classList.contains('selected')) {
                        this.style.boxShadow = '0 8px 25px rgba(0, 0, 0, 0.12)';
                    }
                });

                card.addEventListener('mouseleave', function() {
                    if (!this.classList.contains('selected')) {
                        this.style.boxShadow = '0 4px 20px rgba(0, 0, 0, 0.08)';
                    }
                });
            });

            confirmBtn.addEventListener('click', async function() {
                if (selectedDeck) {
                    confirmBtn.disabled = true;
                    confirmBtn.classList.remove('enabled');
                    statusText.textContent = 'Saved. Waiting for opponent to select...';

                    try {
                        const resp = await fetch(`/game/<%= gameId %>/deck-selection`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ selectedDeck })
                        });
                        // We rely on socket event to redirect when both are ready
                    } catch (e) {
                        console.error('Failed saving deck', e);
                        statusText.textContent = 'Failed to save deck. Please try again.';
                        confirmBtn.disabled = false;
                        confirmBtn.classList.add('enabled');
                    }
                }
            });
        });
    </script>
</body>
</html>
