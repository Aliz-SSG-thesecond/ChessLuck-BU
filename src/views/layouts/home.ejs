<!DOCTYPE html>
<html lang="en">
    <%- include ('../partials/messages.ejs')-%>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChessMaster | Custom Online Chess Platform</title>
    <link rel="icon" type="image/x-icon" href="/images/faveicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,450;0,9..144,600;0,9..144,700;1,9..144,450&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@500;600&display=swap" rel="stylesheet">
    <style>
        html { scroll-behavior: smooth; }

        :root {
            --parchment: #F2E8D0;
            --parchment-deep: #E7D8B0;
            --parchment-line: #C9B786;
            --walnut: #3B2A1E;
            --walnut-soft: #6E5643;
            --walnut-deep: #2C2018;
            --ink: #211508;
            --brass: #A9812C;
            --brass-bright: #C9A227;
            --forest: #445640;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .animate-pulse-slow { animation: pulse 3s infinite; }

        body {
            background-color: var(--parchment);
            background-image: radial-gradient(circle at 1px 1px, rgba(59,42,30,0.07) 1px, transparent 0);
            background-size: 22px 22px;
            font-family: 'Spectral', Georgia, serif;
            color: var(--ink);
        }

        .font-display { font-family: 'Fraunces', serif; }
        .font-utility { font-family: 'Inter', sans-serif; }

        .piece-hover:hover { transform: translateY(-4px); }
        .piece-hover { transition: transform 0.2s ease; }

        /* ---- Nav ---- */
        nav.site-nav { background-color: var(--parchment-deep); border-bottom: 1px solid var(--parchment-line); }
        .brand-mark svg { width: 30px; height: 30px; }
        .brand-name { font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.2rem; letter-spacing: 0.01em; color: var(--walnut); }
        .nav-link {
            font-family: 'Inter', sans-serif; font-size: 0.82rem; font-weight: 500; letter-spacing: 0.02em;
            color: var(--walnut-soft); border-bottom: 1px solid transparent; padding-bottom: 2px;
            transition: color 0.15s ease, border-color 0.15s ease;
        }
        .nav-link:hover { color: var(--walnut); border-color: var(--brass); }
        .btn-ghost { font-family: 'Inter', sans-serif; font-size: 0.82rem; font-weight: 600; color: var(--walnut-soft); transition: color 0.15s ease; }
        .btn-ghost:hover { color: var(--walnut); }
        .btn-outline {
            font-family: 'Inter', sans-serif; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.02em;
            color: var(--walnut); border: 1px solid var(--walnut); padding: 0.55rem 1.1rem; border-radius: 2px;
            transition: background-color 0.15s ease, color 0.15s ease; display: inline-block;
        }
        .btn-outline:hover { background-color: var(--walnut); color: var(--parchment); }
        .hamburger-icon { width: 20px; height: 14px; position: relative; }
        .hamburger-icon span { position: absolute; left: 0; width: 100%; height: 1.5px; background: var(--walnut); }
        .hamburger-icon span:nth-child(1) { top: 0; }
        .hamburger-icon span:nth-child(2) { top: 6px; }
        .hamburger-icon span:nth-child(3) { top: 12px; }

        /* ---- Hero ---- */
        .hero-eyebrow {
            font-family: 'Inter', sans-serif; font-size: 0.72rem; letter-spacing: 0.24em;
            text-transform: uppercase; color: var(--brass); margin-bottom: 0.9rem;
        }
        .hero-title {
            font-family: 'Fraunces', serif; font-weight: 600; font-size: 3rem; line-height: 1.05;
            color: var(--walnut); letter-spacing: -0.01em; margin-bottom: 1.25rem;
        }
        .hero-title em { font-style: italic; color: var(--brass); font-weight: 500; }
        .hero-sub { font-size: 1.08rem; color: var(--walnut-soft); max-width: 42ch; line-height: 1.6; margin-bottom: 2rem; }

        .btn-fill {
            font-family: 'Inter', sans-serif; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.03em;
            background: var(--walnut); color: var(--parchment); border: 1px solid var(--walnut);
            padding: 0.85rem 1.5rem; border-radius: 2px; display: inline-flex; align-items: center; gap: 0.5rem;
            transition: background-color 0.15s ease, color 0.15s ease;
        }
        .btn-fill:hover { background: transparent; color: var(--walnut); }
        .btn-line {
            font-family: 'Inter', sans-serif; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.03em;
            background: transparent; color: var(--walnut); border: 1px solid var(--parchment-line);
            padding: 0.85rem 1.5rem; border-radius: 2px; display: inline-flex; align-items: center; gap: 0.5rem;
            transition: border-color 0.15s ease, color 0.15s ease;
        }
        .btn-line:hover { border-color: var(--brass); color: var(--brass); }

        /* ---- Hero ticket panel ---- */
        .match-ticket {
            background: linear-gradient(160deg, var(--walnut-deep) 0%, var(--walnut) 55%, #4A3624 100%);
            border: 1px solid var(--brass);
            border-radius: 4px;
            padding: 2.25rem 1.75rem;
            position: relative;
            color: var(--parchment);
            box-shadow: 0 24px 48px -20px rgba(33,21,8,0.5);
        }
        .match-ticket::before, .match-ticket::after {
            content: ""; position: absolute; width: 14px; height: 14px;
            background: var(--parchment); border-radius: 50%;
        }
        .match-ticket::before { left: -7px; top: 50%; transform: translateY(-50%); }
        .match-ticket::after { right: -7px; top: 50%; transform: translateY(-50%); }
        .ticket-pieces { display: flex; justify-content: center; gap: 1.5rem; margin-bottom: 1.5rem; }
        .ticket-pieces svg { width: 34px; height: 34px; }
        .ticket-rule { border-top: 1px dashed rgba(242,232,208,0.3); margin: 1.25rem 0; }
        .ticket-row { display: flex; justify-content: space-between; font-family: 'Inter', sans-serif; font-size: 0.72rem; letter-spacing: 0.04em; color: rgba(242,232,208,0.6); text-transform: uppercase; }
        .ticket-row span:last-child { color: var(--brass-bright); }
        .ticket-headline { font-family: 'Fraunces', serif; font-style: italic; text-align: center; font-size: 1rem; color: var(--parchment); margin-bottom: 0.25rem; }
        .live-dot { display:inline-block; width:7px; height:7px; border-radius:50%; background:var(--forest); margin-right:6px; }

        .stamp-badge {
            position: absolute; bottom: -18px; right: 20px;
            background: var(--parchment-deep); border: 1px solid var(--brass);
            border-radius: 4px; padding: 0.6rem 0.9rem;
            box-shadow: 0 10px 24px -12px rgba(33,21,8,0.4);
            display: flex; align-items: center; gap: 0.5rem;
        }
        .stamp-badge svg { width: 18px; height: 18px; }
        .stamp-badge span { font-family: 'Inter', sans-serif; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.02em; color: var(--walnut); }

        /* ---- Section headings ---- */
        .section-eyebrow {
            font-family: 'Inter', sans-serif; font-size: 0.72rem; letter-spacing: 0.22em;
            text-transform: uppercase; color: var(--brass); margin-bottom: 0.6rem;
        }
        .section-title { font-family: 'Fraunces', serif; font-weight: 600; font-size: 2.1rem; color: var(--walnut); letter-spacing: -0.01em; }

        /* ---- Features (editorial list, no icon circles) ---- */
        .feature-row {
            display: grid; grid-template-columns: 90px 1fr; gap: 1.5rem;
            padding: 2rem 0; border-top: 1px solid var(--parchment-line);
        }
        .feature-row:last-child { border-bottom: 1px solid var(--parchment-line); }
        .feature-num { font-family: 'Fraunces', serif; font-style: italic; font-size: 2.2rem; color: var(--parchment-line); }
        .feature-title { font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.3rem; color: var(--walnut); margin-bottom: 0.5rem; }
        .feature-body { color: var(--walnut-soft); max-width: 56ch; line-height: 1.6; }

        /* ---- Game modes ---- */
        .mode-card {
            background: var(--parchment-deep); border: 1px solid var(--parchment-line); border-radius: 4px;
            padding: 1.75rem; transition: border-color 0.2s ease, transform 0.2s ease;
        }
        .mode-card:hover { border-color: var(--brass); transform: translateY(-3px); }
        .mode-letter {
            font-family: 'Fraunces', serif; font-weight: 600; font-style: italic; font-size: 2.4rem;
            color: var(--brass); line-height: 1; margin-bottom: 1rem;
        }
        .mode-title { font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.15rem; color: var(--walnut); margin-bottom: 0.5rem; }
        .mode-body { font-size: 0.92rem; color: var(--walnut-soft); line-height: 1.5; }

        /* ---- CTA band ---- */
        .cta-band { background: var(--walnut); color: var(--parchment); }
        .cta-title { font-family: 'Fraunces', serif; font-weight: 600; font-size: 2.2rem; line-height: 1.15; }
        .cta-sub { font-family: 'Spectral', serif; color: rgba(242,232,208,0.7); font-size: 1.05rem; margin: 1rem 0 2rem; }
        .btn-cream {
            font-family: 'Inter', sans-serif; font-size: 0.88rem; font-weight: 600; letter-spacing: 0.03em;
            background: var(--parchment); color: var(--walnut); border: 1px solid var(--parchment);
            padding: 0.9rem 1.75rem; border-radius: 2px; display: inline-flex; align-items: center; gap: 0.6rem;
            transition: background-color 0.15s ease, color 0.15s ease;
        }
        .btn-cream:hover { background: var(--brass-bright); border-color: var(--brass-bright); color: var(--walnut-deep); }

        /* ---- Footer ---- */
        footer.site-footer { background-color: var(--walnut); color: var(--parchment); border-top: 1px solid var(--brass); }
        footer .footer-heading { font-family: 'Inter', sans-serif; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brass-bright); }
        footer a.footer-link { color: rgba(242,232,208,0.75); font-family: 'Spectral', serif; font-size: 0.92rem; transition: color 0.15s ease; }
        footer a.footer-link:hover { color: var(--brass-bright); }
        footer .brand-blurb { color: rgba(242,232,208,0.65); font-family: 'Spectral', serif; font-size: 0.92rem; max-width: 32ch; }
        .social-mark {
            font-family: 'Inter', sans-serif; font-size: 0.72rem; letter-spacing: 0.08em; color: rgba(242,232,208,0.6);
            border: 1px solid rgba(242,232,208,0.25); padding: 0.3rem 0.55rem; transition: border-color 0.15s ease, color 0.15s ease;
        }
        .social-mark:hover { border-color: var(--brass-bright); color: var(--brass-bright); }
    </style>
</head>

