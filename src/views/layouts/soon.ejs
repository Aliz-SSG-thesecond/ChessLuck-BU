<html lang="en">
    <%- include ('../partials/messages.ejs')-%>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChessMaster | Custom Online Chess Platform</title>
    <link rel="icon" type="image/x-icon" href="/images/faveicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,450;0,9..144,600;0,9..144,700;1,9..144,450&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@500;600&display=swap" rel="stylesheet">
    <style>
        html {
            scroll-behavior: smooth;
        }

        :root {
            --parchment: #F2E8D0;
            --parchment-deep: #E7D8B0;
            --parchment-line: #C9B786;
            --walnut: #3B2A1E;
            --walnut-soft: #6E5643;
            --ink: #211508;
            --brass: #A9812C;
            --brass-bright: #C9A227;
            --forest: #445640;
        }

        body {
            background-color: var(--parchment);
            background-image: radial-gradient(circle at 1px 1px, rgba(59,42,30,0.07) 1px, transparent 0);
            background-size: 22px 22px;
            font-family: 'Spectral', Georgia, serif;
            color: var(--ink);
        }

        .font-display {
            font-family: 'Fraunces', serif;
        }

        .font-utility {
            font-family: 'Inter', sans-serif;
        }

        nav.site-nav {
            background-color: var(--parchment-deep);
            border-bottom: 1px solid var(--parchment-line);
        }

        .brand-mark svg {
            width: 30px;
            height: 30px;
        }

        .brand-name {
            font-family: 'Fraunces', serif;
            font-weight: 600;
            font-size: 1.2rem;
            letter-spacing: 0.01em;
            color: var(--walnut);
        }

        .nav-link {
            font-family: 'Inter', sans-serif;
            font-size: 0.82rem;
            font-weight: 500;
            letter-spacing: 0.02em;
            color: var(--walnut-soft);
            border-bottom: 1px solid transparent;
            padding-bottom: 2px;
            transition: color 0.15s ease, border-color 0.15s ease;
        }

        .nav-link:hover {
            color: var(--walnut);
            border-color: var(--brass);
        }

        .btn-ghost {
            font-family: 'Inter', sans-serif;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--walnut-soft);
            transition: color 0.15s ease;
        }

        .btn-ghost:hover {
            color: var(--walnut);
        }

        .btn-outline {
            font-family: 'Inter', sans-serif;
            font-size: 0.82rem;
            font-weight: 600;
            letter-spacing: 0.02em;
            color: var(--walnut);
            border: 1px solid var(--walnut);
            padding: 0.55rem 1.1rem;
            border-radius: 2px;
            transition: background-color 0.15s ease, color 0.15s ease;
            display: inline-block;
        }

        .btn-outline:hover {
            background-color: var(--walnut);
            color: var(--parchment);
        }

        .hamburger-icon {
            width: 20px;
            height: 14px;
            position: relative;
        }

        .hamburger-icon span {
            position: absolute;
            left: 0;
            width: 100%;
            height: 1.5px;
            background: var(--walnut);
        }

        .hamburger-icon span:nth-child(1) { top: 0; }
        .hamburger-icon span:nth-child(2) { top: 6px; }
        .hamburger-icon span:nth-child(3) { top: 12px; }

        /* ---- Hero ---- */
        .hero-eyebrow {
            font-family: 'Inter', sans-serif;
            font-size: 0.7rem;
            letter-spacing: 0.24em;
            text-transform: uppercase;
            color: var(--brass);
        }

        .hero-rule {
            height: 1px;
            width: 64px;
            background: var(--brass);
        }

        /* ---- Bulletin note (signature element) ---- */
        .bulletin {
            background: var(--parchment-deep);
            border: 1px solid var(--parchment-line);
            box-shadow: 0 20px 40px -20px rgba(33, 21, 8, 0.35);
            transform: rotate(1.4deg);
            position: relative;
        }

        .bulletin::before {
            content: "";
            position: absolute;
            top: -10px;
            left: 50%;
            transform: translateX(-50%) rotate(-4deg);
            width: 34px;
            height: 12px;
            background: rgba(169,129,44,0.55);
            border: 1px solid rgba(169,129,44,0.7);
        }

        .bulletin-title {
            font-family: 'Fraunces', serif;
            font-style: italic;
            font-weight: 500;
            color: var(--walnut);
        }

        .bulletin li {
            font-family: 'Spectral', serif;
            font-size: 0.92rem;
            color: var(--walnut-soft);
            border-bottom: 1px dashed var(--parchment-line);
            padding: 0.55rem 0;
        }

        .bulletin li:last-child { border-bottom: none; }

        .bulletin li em {
            display: block;
            font-style: normal;
            font-family: 'Inter', sans-serif;
            font-size: 0.68rem;
            letter-spacing: 0.03em;
            color: var(--walnut-soft);
            opacity: 0.7;
            margin-top: 0.1rem;
        }

        .clock-dial svg { width: 100%; height: 100%; }
        .clock-hand {
            transform-origin: 32px 32px;
            animation: sweep 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
        }
        @keyframes sweep {
            0%   { transform: rotate(0deg); }
            50%  { transform: rotate(300deg); }
            100% { transform: rotate(360deg); }
        }
        @media (prefers-reduced-motion: reduce) {
            .clock-hand { animation: none; }
        }

        /* ---- Footer ---- */
        footer.site-footer {
            background-color: var(--walnut);
            color: var(--parchment);
            border-top: 1px solid var(--brass);
        }

        footer .footer-heading {
            font-family: 'Inter', sans-serif;
            font-size: 0.72rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--brass-bright);
        }

        footer a.footer-link {
            color: rgba(242,232,208,0.75);
            font-family: 'Spectral', serif;
            font-size: 0.92rem;
            transition: color 0.15s ease;
        }

        footer a.footer-link:hover {
            color: var(--brass-bright);
        }

        footer .brand-blurb {
            color: rgba(242,232,208,0.65);
            font-family: 'Spectral', serif;
            font-size: 0.92rem;
            max-width: 32ch;
        }

        .social-mark {
            font-family: 'Inter', sans-serif;
            font-size: 0.72rem;
            letter-spacing: 0.08em;
            color: rgba(242,232,208,0.6);
            border: 1px solid rgba(242,232,208,0.25);
            padding: 0.3rem 0.55rem;
            transition: border-color 0.15s ease, color 0.15s ease;
        }

        .social-mark:hover {
            border-color: var(--brass-bright);
            color: var(--brass-bright);
        }
    </style>
</head>

<body class="min-h-screen flex flex-col">
