        <div class="max-w-6xl mx-auto px-6 py-20 grid md:grid-cols-[1.2fr_0.9fr] gap-14 items-center">

            <!-- Left: message -->
            <div>
                <div class="hero-eyebrow mb-3">Notice Board</div>
                <h1 class="font-display font-semibold text-4xl md:text-5xl leading-tight mb-5" style="color: var(--walnut);">
                    This room isn't<br/>open yet.
