                    <div class="flex items-center space-x-2 mb-4">
                        <svg viewBox="0 0 32 32" width="24" height="24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M10 27 L9 22 Q8.5 19 11 17 L11 15 Q6 13.5 6 10.5 Q6 7.5 10.5 6.5 Q10 4.5 12.5 3.2 Q15 2 18 3 Q20.5 3.8 20.5 6.2 Q20.5 8 18.5 9 Q21 10 20.5 12.5 L24 16 Q25 17 24 18.5 L20.5 19 L19.5 27 Z"
                                  fill="none" stroke="#C9A227" stroke-width="1.3" stroke-linejoin="round"/>
                            <rect x="8" y="27" width="14" height="2.2" fill="none" stroke="#C9A227" stroke-width="1.3"/>
                        </svg>
                        <span class="font-display font-semibold text-lg">ChessMaster</span>
                    </div>
                    <p class="brand-blurb">A quieter place to play. Rated games, real lessons, and a
                        board that stays out of the way.</p>
                    <div class="flex space-x-2 mt-6">
                        <a href="http://localhost:5000/about" class="social-mark">X</a>
                        <a href="http://localhost:5000/about" class="social-mark">FB</a>
                        <a href="http://localhost:5000/about" class="social-mark">IG</a>
                        <a href="http://localhost:5000/about" class="social-mark">YT</a>
                    </div>
                </div>

                <div>
                    <h3 class="footer-heading mb-4">Play</h3>
                    <ul class="space-y-2">
                        <li><a href="http://localhost:5000/play" class="footer-link">Live Chess</a></li>
                        <li><a href="http://localhost:5000/learn" class="footer-link">Computer</a></li>
                        <li><a href="http://localhost:5000/friends" class="footer-link">Friends</a></li>
                        <li><a href="http://localhost:5000/learn" class="footer-link">Tournaments</a></li>
                        <li><a href="http://localhost:5000/learn" class="footer-link">Variants</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="footer-heading mb-4">Learn</h3>
                    <ul class="space-y-2">
                        <li><a href="http://localhost:5000/learn" class="footer-link">Lessons</a></li>
                        <li><a href="http://localhost:5000/learn" class="footer-link">Puzzles</a></li>
                        <li><a href="http://localhost:5000/learn" class="footer-link">Practice</a></li>
                        <li><a href="http://localhost:5000/learn" class="footer-link">Analysis</a></li>
                        <li><a href="http://localhost:5000/learn" class="footer-link">Opening Explorer</a></li>
