            </div>

            <!-- Right: bulletin note -->
            <div class="bulletin px-7 py-7">
                <div class="flex items-center gap-3 mb-5">
                    <div class="clock-dial" style="width: 40px; height: 40px; flex-shrink: 0;" aria-hidden="true">
                        <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="32" cy="32" r="30" fill="var(--parchment)" stroke="var(--brass)" stroke-width="1.5"/>
                            <circle cx="32" cy="32" r="30" fill="none" stroke="var(--walnut)" stroke-width="0.6" stroke-dasharray="1 6.4" />
                            <g class="clock-hand">
                                <line x1="32" y1="32" x2="32" y2="12" stroke="var(--forest)" stroke-width="2.4" stroke-linecap="round"/>
                            </g>
                            <line x1="32" y1="32" x2="32" y2="20" stroke="var(--walnut)" stroke-width="1.6" stroke-linecap="round"/>
                            <circle cx="32" cy="32" r="2.2" fill="var(--walnut)"/>
                        </svg>
                    </div>
                    <div>
                        <div class="bulletin-title text-base">Under construction</div>
                        <div class="font-utility" style="font-size: 0.68rem; letter-spacing: 0.03em; color: var(--walnut-soft);">no fixed date yet</div>
                    </div>
                </div>
                <ul>
                    <li>Puzzle Rush<em>Timed tactics training</em></li>
                    <li>Opening Explorer<em>Browse main lines by move</em></li>
                    <li>Weekly Ladder<em>Club tournaments, ranked</em></li>
                    <li>Variants<em>Chess960 and beyond</em></li>
                </ul>
            </div>

        </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer py-12">
