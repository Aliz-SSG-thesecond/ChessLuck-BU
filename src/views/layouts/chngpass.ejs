<!DOCTYPE html>
<html lang="en">
<head>
    <%- include ('../partials/messages.ejs')-%>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChessMaster - Set New Password</title>
    <link rel="icon" type="image/x-icon" href="/images/faveicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,450;0,9..144,600;0,9..144,700;1,9..144,450&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --parchment: #F2E8D0;
            --parchment-deep: #E7D8B0;
            --parchment-line: #C9B786;
            --walnut: #3B2A1E;
            --walnut-soft: #6E5643;
            --ink: #211508;
            --brass: #A9812C;
            --brass-bright: #C9A227;
            --forest: #445640;
            --brick: #9C4A36;
        }

        * { box-sizing: border-box; }

        body {
            background-color: var(--parchment);
            background-image: radial-gradient(circle at 1px 1px, rgba(59,42,30,0.07) 1px, transparent 0);
            background-size: 22px 22px;
            font-family: 'Spectral', Georgia, serif;
            color: var(--ink);
        }

        .font-display { font-family: 'Fraunces', serif; }
        .font-utility { font-family: 'Inter', sans-serif; }

        .card {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            background: var(--parchment-deep);
            border: 1px solid var(--parchment-line);
            box-shadow: 0 24px 48px -24px rgba(33, 21, 8, 0.45);
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: "";
            position: absolute;
            inset: 8px;
            border: 1px solid rgba(169,129,44,0.35);
            pointer-events: none;
        }

        /* ---- Left: illustration panel ---- */
        .panel-illustration {
            background: linear-gradient(160deg, #2C2018 0%, #3B2A1E 55%, #4A3624 100%);
            position: relative;
            padding: 2.25rem 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: var(--parchment);
            overflow: hidden;
        }

        .panel-illustration::after {
            content: "";
            position: absolute;
            inset: 0;
            background-image: repeating-linear-gradient(
                115deg,
                rgba(255,255,255,0.025) 0px,
                rgba(255,255,255,0.025) 1px,
                transparent 1px,
                transparent 5px
            );
            pointer-events: none;
        }

        .eyebrow-vertical {
            writing-mode: vertical-rl;
            transform: rotate(180deg);
            font-family: 'Inter', sans-serif;
            font-size: 0.66rem;
            letter-spacing: 0.26em;
            font-weight: 600;
            color: var(--brass-bright);
            text-transform: uppercase;
            z-index: 1;
            margin: 0 auto;
        }

        .king-figure {
            position: relative;
            z-index: 1;
            margin: 1rem auto;
            width: 92px;
        }

        .king-figure svg { width: 100%; height: auto; display: block; }

        .panel-illustration .caption {
            font-family: 'Fraunces', serif;
            font-style: italic;
            font-size: 0.85rem;
            color: rgba(242,232,208,0.55);
            text-align: center;
            z-index: 1;
            line-height: 1.4;
        }

        /* ---- Right: form panel ---- */
        .panel-form {
            background: var(--parchment);
            padding: 2.5rem 2.5rem 2.25rem;
        }

        .eyebrow {
            font-family: 'Inter', sans-serif;
            font-size: 0.7rem;
            letter-spacing: 0.22em;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--brass);
            margin-bottom: 0.5rem;
        }

        h1 {
            font-family: 'Fraunces', serif;
            font-weight: 600;
            font-size: 1.75rem;
            line-height: 1.12;
            margin: 0 0 0.4rem;
            color: var(--walnut);
            letter-spacing: -0.01em;
        }

        .subhead {
            font-size: 0.92rem;
            color: var(--walnut-soft);
            margin: 0 0 1.6rem;
            max-width: 40ch;
            line-height: 1.5;
        }

        label {
            display: block;
            font-family: 'Inter', sans-serif;
            font-size: 0.72rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--walnut-soft);
            margin-bottom: 0.5rem;
        }

        .input-field {
            width: 100%;
            padding: 0.75rem 2.6rem 0.75rem 0.9rem;
            background: var(--parchment);
            border: 1px solid var(--parchment-line);
            border-radius: 2px;
            color: var(--ink);
            font-family: 'Spectral', serif;
            font-size: 0.96rem;
        }

        .input-field::placeholder { color: rgba(110, 86, 67, 0.55); }

        .input-field:focus {
            outline: none;
            border-color: var(--brass);
            box-shadow: 0 0 0 3px rgba(169, 129, 44, 0.22);
        }

        .field-wrap { position: relative; }

        .toggle-password {
            position: absolute;
            right: 0.7rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: var(--walnut-soft);
            padding: 0.2rem;
            line-height: 0;
        }

        .toggle-password:hover { color: var(--walnut); }

        /* custom eye icon, mask-based (no Font Awesome dependency) */
        .icon-eye, .icon-eye-slash {
            display: inline-block;
            width: 18px;
            height: 13px;
            background-color: currentColor;
            -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
            -webkit-mask-position: center;
            mask-position: center;
            -webkit-mask-size: contain;
            mask-size: contain;
        }
        .icon-eye {
            -webkit-mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 16'><path d='M1 8 Q12 -2 23 8 Q12 18 1 8 Z' fill='none' stroke='black' stroke-width='1.6'/><circle cx='12' cy='8' r='2.6' fill='black'/></svg>");
            mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 16'><path d='M1 8 Q12 -2 23 8 Q12 18 1 8 Z' fill='none' stroke='black' stroke-width='1.6'/><circle cx='12' cy='8' r='2.6' fill='black'/></svg>");
        }
        .icon-eye-slash {
            -webkit-mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 16'><path d='M1 8 Q12 -2 23 8 Q12 18 1 8 Z' fill='none' stroke='black' stroke-width='1.6'/><circle cx='12' cy='8' r='2.6' fill='black'/><line x1='1' y1='1' x2='23' y2='15' stroke='black' stroke-width='1.8'/></svg>");
            mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 16'><path d='M1 8 Q12 -2 23 8 Q12 18 1 8 Z' fill='none' stroke='black' stroke-width='1.6'/><circle cx='12' cy='8' r='2.6' fill='black'/><line x1='1' y1='1' x2='23' y2='15' stroke='black' stroke-width='1.8'/></svg>");
        }

        /* ---- Password strength ---- */
        .password-strength { margin-top: 0.7rem; transition: all 0.3s ease; }

        .strength-row {
            display: flex;
            justify-content: space-between;
            font-family: 'Inter', sans-serif;
            font-size: 0.68rem;
            letter-spacing: 0.03em;
            color: var(--walnut-soft);
            text-transform: uppercase;
        }

        #strengthText { font-weight: 600; color: var(--walnut); }

        .strength-track {
            width: 100%;
            background: var(--parchment-line);
            border-radius: 2px;
            height: 4px;
            margin-top: 0.4rem;
            overflow: hidden;
        }

        #strengthBar { height: 4px; border-radius: 2px; transition: width 0.3s ease, background-color 0.3s ease; }
        .bar-weak { background: var(--brick); }
        .bar-moderate { background: var(--brass); }
        .bar-strong { background: var(--forest); }

        /* ---- Requirements list ---- */
        .req-list {
            font-family: 'Inter', sans-serif;
            font-size: 0.76rem;
            color: var(--walnut-soft);
            margin-top: 0.75rem;
        }
        .req-list li {
            display: flex;
            align-items: center;
            padding: 0.2rem 0;
        }

        .icon-dot, .icon-check {
            display: inline-block;
            width: 10px;
            height: 10px;
            margin-right: 0.55rem;
            background-color: currentColor;
            -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
            -webkit-mask-position: center;
            mask-position: center;
            -webkit-mask-size: contain;
            mask-size: contain;
            flex-shrink: 0;
        }
        .icon-dot {
            -webkit-mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10'><circle cx='5' cy='5' r='3.2' fill='black'/></svg>");
            mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10'><circle cx='5' cy='5' r='3.2' fill='black'/></svg>");
        }
        .icon-check {
            -webkit-mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10'><circle cx='5' cy='5' r='4.3' fill='none' stroke='black' stroke-width='1'/><path d='M2.8 5.2 L4.3 6.7 L7.2 3.4' fill='none' stroke='black' stroke-width='1.1' stroke-linecap='round' stroke-linejoin='round'/></svg>");
            mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10'><circle cx='5' cy='5' r='4.3' fill='none' stroke='black' stroke-width='1'/><path d='M2.8 5.2 L4.3 6.7 L7.2 3.4' fill='none' stroke='black' stroke-width='1.1' stroke-linecap='round' stroke-linejoin='round'/></svg>");
        }

        .req-unmet { color: var(--parchment-line); }
        .req-met { color: var(--forest); }
        .req-list li.met span { color: var(--walnut); }

        /* ---- Match indicator ---- */
        #passwordMatch { font-family: 'Inter', sans-serif; font-size: 0.74rem; margin-top: 0.4rem; }
        .match-ok { color: var(--forest); }
        .match-bad { color: var(--brick); }

        /* ---- Submit ---- */
        .btn-primary {
            width: 100%;
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.03em;
            cursor: pointer;
            padding: 0.85rem 1rem;
            border-radius: 2px;
            border: 1px solid var(--walnut);
            background: var(--walnut);
            color: var(--parchment);
            transition: background-color 0.15s ease, color 0.15s ease;
        }
        .btn-primary:hover:not(:disabled) { background: transparent; color: var(--walnut); }
        .btn-primary:disabled { opacity: 0.45; cursor: not-allowed; }
        .btn-primary:focus-visible { outline: 2px solid var(--brass); outline-offset: 2px; }

        /* ---- Footer note ---- */
        .form-footnote {
            margin-top: 1.5rem;
            padding-top: 1.1rem;
            border-top: 1px dashed var(--parchment-line);
            font-family: 'Inter', sans-serif;
            font-size: 0.74rem;
            color: var(--walnut-soft);
        }
        .form-footnote a {
            color: var(--walnut);
            font-weight: 600;
            border-bottom: 1px solid var(--brass);
            padding-bottom: 1px;
        }
        .form-footnote a:hover { color: var(--brass); }

        @media (max-width: 640px) {
            .card { grid-template-columns: 1fr; }
            .panel-illustration {
                flex-direction: row;
                justify-content: center;
                gap: 1rem;
                padding: 1.25rem;
            }
            .eyebrow-vertical { writing-mode: horizontal-tb; transform: none; margin: 0; }
            .king-figure { width: 52px; margin: 0; }
            .panel-illustration .caption { display: none; }
            .panel-form { padding: 2rem 1.5rem; }
            h1 { font-size: 1.5rem; }
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">

    <div class="w-full" style="max-width: 760px;">
        <div class="card">

            <!-- Left: illustration -->
            <div class="panel-illustration">
                <div class="eyebrow-vertical">Account &middot; Settings</div>
                <div class="king-figure" aria-hidden="true">
                    <svg viewBox="0 0 100 130" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <pattern id="hatch5" width="4" height="4" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
                                <line x1="0" y1="0" x2="0" y2="4" stroke="#C9A227" stroke-width="0.6" opacity="0.55"/>
                            </pattern>
                        </defs>
                        <path d="M32 100 L30 84 Q29 74 38 68 Q28 62 28 50 Q28 36 50 30 Q72 36 72 50 Q72 62 62 68 Q71 74 70 84 L68 100 Z"
                            fill="url(#hatch5)" stroke="#F2E8D0" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"/>
                        <path d="M32 100 L30 84 Q29 74 38 68 Q28 62 28 50 Q28 36 50 30 Q72 36 72 50 Q72 62 62 68 Q71 74 70 84 L68 100 Z"
                            fill="none" stroke="#F2E8D0" stroke-width="1.6" stroke-linejoin="round"/>
                        <line x1="50" y1="6" x2="50" y2="16" stroke="#F2E8D0" stroke-width="1.6" stroke-linecap="round"/>
                        <line x1="44" y1="11" x2="56" y2="11" stroke="#F2E8D0" stroke-width="1.6" stroke-linecap="round"/>
                        <circle cx="50" cy="52" r="5.5" fill="none" stroke="#F2E8D0" stroke-width="1.6"/>
                        <line x1="50" y1="57" x2="50" y2="66" stroke="#F2E8D0" stroke-width="1.6" stroke-linecap="round"/>
                        <rect x="24" y="100" width="52" height="6" fill="none" stroke="#F2E8D0" stroke-width="1.4"/>
                    </svg>
                </div>
                <p class="caption">A password<br/>only you<br/>should know.</p>
            </div>

            <!-- Right: form -->
            <div class="panel-form">
                <div class="eyebrow">Account Settings</div>
                <h1>Update your password</h1>
                <p class="subhead">Choose something you don't use anywhere else. You'll need it the next time you sign in.</p>

                <form id="passwordForm" action="/auth/changepassword" method="POST">
                    <!-- New Password -->
                    <div class="mb-5">
                        <label for="newPassword">New password</label>
                        <div class="field-wrap">
                            <input
                                name="password"
                                type="password"
                                id="newPassword"
                                class="input-field"
                                placeholder="Create new password"
                                required
                                minlength="8">
                            <button type="button" class="toggle-password" data-target="newPassword">
                                <i class="icon-eye"></i>
                            </button>
                        </div>

                        <div class="password-strength">
                            <div class="strength-row">
                                <span>Password strength</span>
                                <span id="strengthText">Weak</span>
                            </div>
                            <div class="strength-track">
                                <div id="strengthBar" class="bar-weak" style="width: 25%"></div>
                            </div>
                        </div>

                        <ul class="req-list">
                            <li class="requirement" data-requirement="length">
                                <i class="icon-dot req-unmet"></i>
                                <span>At least 8 characters</span>
                            </li>
                            <li class="requirement" data-requirement="uppercase">
                                <i class="icon-dot req-unmet"></i>
                                <span>At least 1 uppercase letter</span>
                            </li>
                            <li class="requirement" data-requirement="number">
                                <i class="icon-dot req-unmet"></i>
                                <span>At least 1 number</span>
                            </li>
                            <li class="requirement" data-requirement="special">
                                <i class="icon-dot req-unmet"></i>
                                <span>At least 1 special character</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-6">
                        <label for="confirmPassword">Confirm new password</label>
                        <div class="field-wrap">
                            <input
                                type="password"
                                id="confirmPassword"
                                class="input-field"
                                placeholder="Confirm new password"
                                required>
                            <button type="button" class="toggle-password" data-target="confirmPassword">
                                <i class="icon-eye"></i>
                            </button>
                        </div>
                        <p id="passwordMatch" class="hidden"></p>
                    </div>

                    <!-- Submit Button -->
                    <button
                        type="submit"
                        id="submitBtn"
                        class="btn-primary"
                        >
                        Update password
                    </button>
                </form>

                <div class="form-footnote">
                    Remember to use a unique password for ChessMaster. <a href="#">Learn more</a>
                </div>
            </div>

        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Password toggle visibility
            const toggleButtons = document.querySelectorAll('.toggle-password');
            toggleButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const targetId = this.getAttribute('data-target');
                    const input = document.getElementById(targetId);
                    const icon = this.querySelector('i');
                    
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.replace('icon-eye', 'icon-eye-slash');
                    } else {
                        input.type = 'password';
                        icon.classList.replace('icon-eye-slash', 'icon-eye');
                    }
                });
            });

            // Password strength checker
            const newPasswordInput = document.getElementById('newPassword');
            const confirmPasswordInput = document.getElementById('confirmPassword');
            const strengthBar = document.getElementById('strengthBar');
            const strengthText = document.getElementById('strengthText');
            const passwordMatch = document.getElementById('passwordMatch');
            const submitBtn = document.getElementById('submitBtn');
            const requirementItems = document.querySelectorAll('.requirement');

            newPasswordInput.addEventListener('input', checkPasswordStrength);
            confirmPasswordInput.addEventListener('input', checkPasswordMatch);

            function checkPasswordStrength() {
                const password = newPasswordInput.value;
                let strength = 0;
                
                // Check password requirements
                const hasLength = password.length >= 8;
                const hasUppercase = /[A-Z]/.test(password);
                const hasNumber = /[0-9]/.test(password);
                const hasSpecial = /[!@#$%^&*(),.?":{}|<>]/.test(password);
                
                // Update requirement indicators
                updateRequirement('length', hasLength);
                updateRequirement('uppercase', hasUppercase);
                updateRequirement('number', hasNumber);
                updateRequirement('special', hasSpecial);
                
                // Calculate strength
                if (hasLength) strength += 25;
                if (hasUppercase) strength += 25;
                if (hasNumber) strength += 25;
                if (hasSpecial) strength += 25;
                
                // Update strength bar and text
                strengthBar.style.width = strength + '%';
                
                if (strength < 50) {
                    strengthBar.className = 'bar-weak';
                    strengthText.textContent = 'Weak';
                } else if (strength < 75) {
                    strengthBar.className = 'bar-moderate';
                    strengthText.textContent = 'Moderate';
                } else {
                    strengthBar.className = 'bar-strong';
                    strengthText.textContent = 'Strong';
                }
                
                // Enable/disable submit button based on password validity
                checkFormValidity();
            }
            
            function updateRequirement(type, isValid) {
                const item = document.querySelector(`.requirement[data-requirement="${type}"]`);
                const icon = item.querySelector('i');
                
                if (isValid) {
                    item.classList.add('met');
                    icon.className = 'icon-check req-met';
                } else {
                    item.classList.remove('met');
                    icon.className = 'icon-dot req-unmet';
                }
            }
            
            function checkPasswordMatch() {
                const password = newPasswordInput.value;
                const confirmPassword = confirmPasswordInput.value;
                
                if (confirmPassword === '') {
                    passwordMatch.classList.add('hidden');
                    passwordMatch.textContent = '';
                } else if (password === confirmPassword) {
                    passwordMatch.classList.remove('hidden');
                    passwordMatch.textContent = 'Passwords match!';
                    passwordMatch.className = 'match-ok';
                } else {
                    passwordMatch.classList.remove('hidden');
                    passwordMatch.textContent = 'Passwords do not match';
                    passwordMatch.className = 'match-bad';
                }
                
                checkFormValidity();
            }
            
            function checkFormValidity() {
                const password = newPasswordInput.value;
                const confirmPassword = confirmPasswordInput.value;
                const currentPassword = document.getElementById('currentPassword').value;
                
                // Check if all requirements are met
                const hasLength = password.length >= 8;
                const hasUppercase = /[A-Z]/.test(password);
                const hasNumber = /[0-9]/.test(password);
                const hasSpecial = /[!@#$%^&*(),.?":{}|<>]/.test(password);
                const passwordsMatch = password === confirmPassword && password !== '';
                
                const isValid = currentPassword !== '' && hasLength && hasUppercase && hasNumber && hasSpecial && passwordsMatch;
                
                submitBtn.disabled = !isValid;
            }
            
            // Form submission
        //     const passwordForm = document.getElementById('passwordForm');
        //     passwordForm.addEventListener('submit', function(e) {
        //         e.preventDefault();
                
        //         // Simulate form submission
        //         submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Updating...';
        //         submitBtn.disabled = true;
                
        //         setTimeout(() => {
        //             // Show success message (in a real app, you would handle the actual password change)
        //             alert('Password updated successfully!');
        //             submitBtn.innerHTML = 'Update Password';
        //             passwordForm.reset();
        //             strengthBar.style.width = '25%';
        //             strengthBar.className = 'bg-red-500 h-1.5 rounded-full';
        //             strengthText.textContent = 'Weak';
        //             passwordMatch.classList.add('hidden');
                    
        //             // Reset requirement indicators
        //             requirementItems.forEach(item => {
        //                 const icon = item.querySelector('i');
        //                 icon.className = 'fas fa-circle text-xs mr-2 text-red-500';
        //             });
        //         }, 1500);
        //     });
        });
    </script>
</body>
</html>
