<!DOCTYPE html>
<html lang="en">
<head>
    <%- include ('../partials/messages.ejs')-%>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Finding an Opponent — Chess</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,450;0,9..144,600;0,9..144,700;1,9..144,450&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --parchment: #F2E8D0;
      --parchment-deep: #E7D8B0;
      --parchment-line: #C9B786;
      --walnut: #3B2A1E;
      --walnut-soft: #6E5643;
      --ink: #211508;
      --brass: #A9812C;
      --brass-bright: #C9A227;
      --forest: #445640;
      --card-shadow: 0 24px 48px -24px rgba(33, 21, 8, 0.45);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--parchment);
      background-image:
        radial-gradient(circle at 1px 1px, rgba(59,42,30,0.07) 1px, transparent 0);
      background-size: 22px 22px;
      font-family: 'Spectral', Georgia, serif;
      color: var(--ink);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1.25rem;
    }

    .card {
      width: 100%;
      max-width: 720px;
      display: grid;
      grid-template-columns: 0.82fr 1.18fr;
      background: var(--parchment-deep);
      border: 1px solid var(--parchment-line);
      box-shadow: var(--card-shadow);
      position: relative;
      overflow: hidden;
    }

    .card::before {
      /* deckle / torn top edge feel via hairline frame */
      content: "";
      position: absolute;
      inset: 8px;
      border: 1px solid rgba(169,129,44,0.35);
      pointer-events: none;
    }

    /* ---- Left panel: illustration ---- */
    .panel-illustration {
      background: linear-gradient(160deg, #2C2018 0%, #3B2A1E 55%, #4A3624 100%);
      position: relative;
      padding: 2rem 1.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: var(--parchment);
      overflow: hidden;
    }

    .panel-illustration::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(
        115deg,
        rgba(255,255,255,0.025) 0px,
        rgba(255,255,255,0.025) 1px,
        transparent 1px,
        transparent 5px
      );
      pointer-events: none;
    }

    .eyebrow-vertical {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-family: 'Inter', sans-serif;
      font-size: 0.68rem;
      letter-spacing: 0.28em;
      font-weight: 600;
      color: var(--brass-bright);
      text-transform: uppercase;
      z-index: 1;
      margin: 0 auto;
    }

    .knight-figure {
      position: relative;
      z-index: 1;
      margin: 1rem auto;
      width: 108px;
    }

    .knight-figure svg { width: 100%; height: auto; display: block; }

    .panel-illustration .caption {
      font-family: 'Fraunces', serif;
      font-style: italic;
      font-size: 0.85rem;
      color: rgba(242,232,208,0.55);
      text-align: center;
      z-index: 1;
      line-height: 1.4;
    }

    /* ---- Right panel: content ---- */
    .panel-content {
      background: var(--parchment);
      padding: 2.75rem 2.5rem 2.25rem;
      display: flex;
      flex-direction: column;
    }

    .eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 0.7rem;
      letter-spacing: 0.22em;
      font-weight: 600;
      text-transform: uppercase;
      color: var(--brass);
      margin-bottom: 0.65rem;
    }

    h1 {
      font-family: 'Fraunces', serif;
      font-weight: 600;
      font-size: 2.15rem;
      line-height: 1.08;
      margin: 0 0 0.6rem;
      color: var(--walnut);
      letter-spacing: -0.01em;
    }

    .subhead {
      font-size: 0.98rem;
      color: var(--walnut-soft);
      margin: 0 0 1.75rem;
      max-width: 34ch;
      line-height: 1.5;
    }

    .rule {
      height: 1px;
      background: linear-gradient(90deg, var(--brass) 0%, rgba(169,129,44,0.15) 100%);
      margin: 0 0 1.75rem;
    }

    /* ---- Chess-clock status indicator (signature element) ---- */
    .status-row {
      display: flex;
      align-items: center;
      gap: 1.1rem;
      margin-bottom: 2rem;
    }

    .clock-dial {
      flex-shrink: 0;
      width: 64px;
      height: 64px;
      position: relative;
    }

    .clock-dial svg { width: 100%; height: 100%; }

    .clock-hand {
      transform-origin: 32px 32px;
      animation: sweep 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @keyframes sweep {
      0%   { transform: rotate(0deg); }
      50%  { transform: rotate(300deg); }
      100% { transform: rotate(360deg); }
    }

    @media (prefers-reduced-motion: reduce) {
      .clock-hand { animation: none; }
    }

    .status-text .label {
      font-family: 'Fraunces', serif;
      font-weight: 600;
      font-size: 1.05rem;
      color: var(--walnut);
      margin-bottom: 0.15rem;
    }

    .status-text .sub {
      font-family: 'Inter', sans-serif;
      font-size: 0.76rem;
      letter-spacing: 0.04em;
      color: var(--walnut-soft);
    }

    .status-text .sub::before {
      content: "●";
      color: var(--forest);
      font-size: 0.55rem;
      margin-right: 0.4rem;
      display: inline-block;
      animation: pulse-dot 1.6s ease-in-out infinite;
    }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.25; }
    }

    /* ---- Ticket-style meta strip ---- */
    .meta-strip {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-top: 1px dashed var(--parchment-line);
      border-bottom: 1px dashed var(--parchment-line);
      padding: 0.85rem 0;
      margin-bottom: 2rem;
    }

    .meta-strip div {
      font-family: 'Inter', sans-serif;
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--walnut-soft);
    }

    .meta-strip span {
      display: block;
      font-family: 'Fraunces', serif;
      font-size: 0.95rem;
      text-transform: none;
      letter-spacing: 0;
      color: var(--walnut);
      margin-top: 0.15rem;
    }

    /* ---- Actions ---- */
    .actions {
      margin-top: auto;
      display: flex;
      justify-content: flex-start;
    }

    button {
      font-family: 'Inter', sans-serif;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      cursor: pointer;
      padding: 0.8rem 1.6rem;
      border-radius: 2px;
      border: 1px solid var(--walnut);
      background: transparent;
      color: var(--walnut);
      transition: background-color 0.18s ease, color 0.18s ease;
    }

    button:hover {
      background-color: var(--walnut);
      color: var(--parchment);
    }

    button:focus-visible {
      outline: 2px solid var(--brass);
      outline-offset: 2px;
    }

    /* ---- Responsive ---- */
    @media (max-width: 620px) {
      .card {
        grid-template-columns: 1fr;
      }
      .panel-illustration {
        flex-direction: row;
        justify-content: center;
        gap: 1rem;
        padding: 1.25rem;
      }
      .eyebrow-vertical {
        writing-mode: horizontal-tb;
        transform: none;
        margin: 0;
      }
      .knight-figure {
        width: 56px;
        margin: 0;
      }
      .panel-illustration .caption { display: none; }
      .panel-content {
        padding: 2rem 1.5rem;
      }
      h1 { font-size: 1.7rem; }
    }
  </style>
</head>
<body>

  <div class="card">

    <!-- Left: illustrated panel -->
    <div class="panel-illustration">
      <div class="eyebrow-vertical">Match &middot; In Progress</div>
      <div class="knight-figure" aria-hidden="true">
        <svg viewBox="0 0 100 130" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="hatch" width="4" height="4" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
              <line x1="0" y1="0" x2="0" y2="4" stroke="#C9A227" stroke-width="0.6" opacity="0.55"/>
            </pattern>
          </defs>
          <path d="M30 122 L28 108 Q26 96 34 88 L34 82 Q22 78 22 64 Q22 50 34 42 Q32 34 40 26 Q46 18 58 18 Q70 18 74 30 Q78 40 70 46 Q78 52 76 62 L86 74 Q90 78 86 84 L74 86 L70 122 Z"
                fill="url(#hatch)" stroke="#F2E8D0" stroke-width="1.4" stroke-linejoin="round"/>
          <path d="M30 122 L28 108 Q26 96 34 88 L34 82 Q22 78 22 64 Q22 50 34 42 Q32 34 40 26 Q46 18 58 18 Q70 18 74 30 Q78 40 70 46 Q78 52 76 62 L86 74 Q90 78 86 84 L74 86 L70 122 Z"
                fill="none" stroke="#F2E8D0" stroke-width="1.6" stroke-linejoin="round"/>
          <circle cx="52" cy="34" r="2" fill="#F2E8D0"/>
          <rect x="18" y="120" width="56" height="6" fill="none" stroke="#F2E8D0" stroke-width="1.4"/>
        </svg>
      </div>
      <p class="caption">One board.<br/>Two players.<br/>No shortcuts.</p>
    </div>

    <!-- Right: content -->
    <div class="panel-content">
      <div class="eyebrow">Matchmaking</div>
      <h1>Finding your opponent</h1>
      <p class="subhead">We're pairing you with a player of comparable strength. This usually takes a few moments.</p>

      <div class="rule"></div>

      <div class="status-row" id="status">
        <div class="clock-dial" aria-hidden="true">
          <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
            <circle cx="32" cy="32" r="30" fill="#F2E8D0" stroke="#A9812C" stroke-width="1.5"/>
            <circle cx="32" cy="32" r="30" fill="none" stroke="#3B2A1E" stroke-width="0.6" stroke-dasharray="1 6.4" />
            <g class="clock-hand">
              <line x1="32" y1="32" x2="32" y2="12" stroke="#445640" stroke-width="2.4" stroke-linecap="round"/>
            </g>
            <line x1="32" y1="32" x2="32" y2="20" stroke="#3B2A1E" stroke-width="1.6" stroke-linecap="round"/>
            <circle cx="32" cy="32" r="2.2" fill="#3B2A1E"/>
          </svg>
        </div>
        <div class="status-text">
          <div class="label">Searching for opponent</div>
          <div class="sub">live &middot; matching by rating</div>
        </div>
      </div>

      <div class="meta-strip">
        <div>Time control<span>10 + 0</span></div>
        <div>Rated<span>Yes</span></div>
        <div>Queue<span id="queueTime">0:00</span></div>
      </div>

      <div class="actions">
        <button id="cancelBtn" type="button">Cancel search</button>
      </div>
    </div>

  </div>

</body>
<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();

  // Register this user with server
  socket.emit("registerUser", "<%= userId %>");

  // If matched → redirect instantly
  socket.on("goToDeckSelection", (data) => {
    window.location.href = `/game/${data.gameId}/deck-selection`;
  });

  // Cosmetic queue timer (visual only)
  (function () {
    const el = document.getElementById("queueTime");
    if (!el) return;
    let seconds = 0;
    setInterval(() => {
      seconds += 1;
      const m = Math.floor(seconds / 60);
      const s = seconds % 60;
      el.textContent = `${m}:${s.toString().padStart(2, "0")}`;
    }, 1000);
  })();
</script>

</html>
