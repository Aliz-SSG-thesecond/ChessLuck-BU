<!DOCTYPE html>
<html lang="en">
<head>
<%- include ('../partials/messages.ejs')-%>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Password Recovery | Secure Access</title>
<link rel="icon" type="image/x-icon" href="/images/faveicon.ico">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,450;0,9..144,600;0,9..144,700;1,9..144,450&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --parchment: #F2E8D0;
    --parchment-deep: #E7D8B0;
    --parchment-line: #C9B786;
    --walnut: #3B2A1E;
    --walnut-soft: #6E5643;
    --ink: #211508;
    --brass: #A9812C;
    --brass-bright: #C9A227;
    --forest: #445640;
  }

  * { box-sizing: border-box; }

  body {
    background-color: var(--parchment);
    background-image: radial-gradient(circle at 1px 1px, rgba(59,42,30,0.07) 1px, transparent 0);
    background-size: 22px 22px;
    font-family: 'Spectral', Georgia, serif;
    color: var(--ink);
  }

  .font-display { font-family: 'Fraunces', serif; }
  .font-utility { font-family: 'Inter', sans-serif; }

  .card {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    background: var(--parchment-deep);
    border: 1px solid var(--parchment-line);
    box-shadow: 0 24px 48px -24px rgba(33, 21, 8, 0.45);
    position: relative;
    overflow: hidden;
  }

  .card::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(169,129,44,0.35);
    pointer-events: none;
  }

  /* ---- Left: illustration panel ---- */
  .panel-illustration {
    background: linear-gradient(160deg, #2C2018 0%, #3B2A1E 55%, #4A3624 100%);
    position: relative;
    padding: 2.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--parchment);
    overflow: hidden;
  }

  .panel-illustration::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      115deg,
      rgba(255,255,255,0.025) 0px,
      rgba(255,255,255,0.025) 1px,
      transparent 1px,
      transparent 5px
    );
    pointer-events: none;
  }

  .eyebrow-vertical {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: 'Inter', sans-serif;
    font-size: 0.66rem;
    letter-spacing: 0.26em;
    font-weight: 600;
    color: var(--brass-bright);
    text-transform: uppercase;
    z-index: 1;
    margin: 0 auto;
  }

  .king-figure {
    position: relative;
    z-index: 1;
    margin: 1rem auto;
    width: 96px;
  }

  .king-figure svg { width: 100%; height: auto; display: block; }

  .panel-illustration .caption {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 0.85rem;
    color: rgba(242,232,208,0.55);
    text-align: center;
    z-index: 1;
    line-height: 1.4;
  }

  /* ---- Right: form panel ---- */
  .panel-form {
    background: var(--parchment);
    padding: 2.75rem 2.5rem;
  }

  .eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 0.6rem;
  }

  h1 {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 1.9rem;
    line-height: 1.1;
    margin: 0 0 0.55rem;
    color: var(--walnut);
    letter-spacing: -0.01em;
  }

  .subhead {
    font-size: 0.96rem;
    color: var(--walnut-soft);
    margin: 0 0 1.9rem;
    max-width: 36ch;
    line-height: 1.5;
  }

  label {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--walnut-soft);
    margin-bottom: 0.5rem;
  }

  .input-field {
    width: 100%;
    padding: 0.8rem 0.9rem;
    background: var(--parchment);
    border: 1px solid var(--parchment-line);
    border-radius: 2px;
    color: var(--ink);
    font-family: 'Spectral', serif;
    font-size: 0.98rem;
  }

  .input-field::placeholder { color: rgba(110, 86, 67, 0.55); }

  .input-field:focus {
    outline: none;
    border-color: var(--brass);
    box-shadow: 0 0 0 3px rgba(169, 129, 44, 0.22);
  }

  .btn-primary {
    width: 100%;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    cursor: pointer;
    padding: 0.85rem 1rem;
    border-radius: 2px;
    border: 1px solid var(--walnut);
    background: var(--walnut);
    color: var(--parchment);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .btn-primary:hover {
    background: transparent;
    color: var(--walnut);
  }

  .btn-primary:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
  }

  /* repurposed FA hook classes: kept for any external JS toggling `hidden`,
     restyled as a custom ring spinner (no Font Awesome dependency) */
  .fa-spinner {
    width: 13px;
    height: 13px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    display: inline-block;
  }
  .fa-spin { animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .signin-link {
    display: block;
    text-align: center;
    margin-top: 1.1rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    color: var(--walnut-soft);
  }

  .signin-link a {
    color: var(--walnut);
    font-weight: 600;
    border-bottom: 1px solid var(--brass);
    padding-bottom: 1px;
    transition: color 0.15s ease;
  }

  .signin-link a:hover { color: var(--brass); }

  /* ---- Wax-seal security note ---- */
  .security-note {
    margin-top: 1.9rem;
    padding-top: 1.4rem;
    border-top: 1px dashed var(--parchment-line);
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .seal {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
  }

  .security-note p {
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--walnut-soft);
    margin: 0;
  }

  .success-message {
    animation: fadeIn 0.5s ease-in-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 640px) {
    .card { grid-template-columns: 1fr; }
    .panel-illustration {
      flex-direction: row;
      justify-content: center;
      gap: 1rem;
      padding: 1.25rem;
    }
    .eyebrow-vertical { writing-mode: horizontal-tb; transform: none; margin: 0; }
    .king-figure { width: 52px; margin: 0; }
    .panel-illustration .caption { display: none; }
    .panel-form { padding: 2rem 1.5rem; }
    h1 { font-size: 1.6rem; }
  }
</style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">

<div class="w-full space-y-4" style="max-width: 720px;">

  <%- include('../partials/messages.ejs') %>

  <div class="card">

    <!-- Left: illustration -->
    <div class="panel-illustration">
      <div class="eyebrow-vertical">Account &middot; Recovery</div>
      <div class="king-figure" aria-hidden="true">
        <svg viewBox="0 0 100 130" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="hatch2" width="4" height="4" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
              <line x1="0" y1="0" x2="0" y2="4" stroke="#C9A227" stroke-width="0.6" opacity="0.55"/>
            </pattern>
          </defs>
          <path d="M32 100 L30 84 Q29 74 38 68 Q28 62 28 50 Q28 36 50 30 Q72 36 72 50 Q72 62 62 68 Q71 74 70 84 L68 100 Z"
                fill="url(#hatch2)" stroke="#F2E8D0" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"/>
          <path d="M32 100 L30 84 Q29 74 38 68 Q28 62 28 50 Q28 36 50 30 Q72 36 72 50 Q72 62 62 68 Q71 74 70 84 L68 100 Z"
                fill="none" stroke="#F2E8D0" stroke-width="1.6" stroke-linejoin="round"/>
          <line x1="50" y1="6" x2="50" y2="16" stroke="#F2E8D0" stroke-width="1.6" stroke-linecap="round"/>
          <line x1="44" y1="11" x2="56" y2="11" stroke="#F2E8D0" stroke-width="1.6" stroke-linecap="round"/>
          <circle cx="50" cy="52" r="5.5" fill="none" stroke="#F2E8D0" stroke-width="1.6"/>
          <line x1="50" y1="57" x2="50" y2="66" stroke="#F2E8D0" stroke-width="1.6" stroke-linecap="round"/>
          <rect x="24" y="100" width="52" height="6" fill="none" stroke="#F2E8D0" stroke-width="1.4"/>
        </svg>
      </div>
      <p class="caption">Every game<br/>begins with<br/>protecting the king.</p>
    </div>

    <!-- Right: form -->
    <div class="panel-form">
      <div class="eyebrow">Account Recovery</div>
      <h1>Reset your password</h1>
      <p class="subhead">Enter the email on your account and we'll send a link to choose a new one.</p>

      <form action="/auth/recovery" method="POST" class="space-y-5">
        <div>
          <label for="email">Email address</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="input-field"
            placeholder="you@example.com"
          />
        </div>

        <div>
          <button type="submit" class="btn-primary">
            <span>Send reset link</span>
            <i class="fas fa-spinner fa-spin ml-2 hidden"></i>
          </button>
        </div>
      </form>

      <div class="signin-link">
        <span>Remember your password?</span> <a href="/login">Sign in</a>
      </div>

      <div class="security-note">
        <svg class="seal" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="16" cy="16" r="14.5" fill="none" stroke="#A9812C" stroke-width="1.2"/>
          <circle cx="16" cy="16" r="11.5" fill="none" stroke="#A9812C" stroke-width="0.6" stroke-dasharray="0.8 3.4"/>
          <path d="M16 9 L21 11.5 V16.5 Q21 21 16 23 Q11 21 11 16.5 V11.5 Z"
                fill="none" stroke="#A9812C" stroke-width="1.2" stroke-linejoin="round"/>
        </svg>
        <p>Your information is secured with 256&#8209;bit encryption.</p>
      </div>
    </div>

  </div>

</div>

</body>
</html>
