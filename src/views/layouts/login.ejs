<html lang="en">
<%- include ('../partials/messages.ejs')-%>

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ChessMaster | Custom Online Chess Platform</title>
        <link rel="icon" type="image/x-icon" href="/images/faveicon.ico">
        <script src="https://cdn.tailwindcss.com"></script>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,450;0,9..144,600;0,9..144,700;1,9..144,450&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@500;600&display=swap" rel="stylesheet">
        <style>
            html { scroll-behavior: smooth; }

            :root {
                --parchment: #F2E8D0;
                --parchment-deep: #E7D8B0;
                --parchment-line: #C9B786;
                --walnut: #3B2A1E;
                --walnut-soft: #6E5643;
                --ink: #211508;
                --brass: #A9812C;
                --brass-bright: #C9A227;
                --forest: #445640;
            }

            body {
                background-color: var(--parchment);
                background-image: radial-gradient(circle at 1px 1px, rgba(59,42,30,0.07) 1px, transparent 0);
                background-size: 22px 22px;
                font-family: 'Spectral', Georgia, serif;
                color: var(--ink);
            }

            .font-display { font-family: 'Fraunces', serif; }
            .font-utility { font-family: 'Inter', sans-serif; }

            /* ---- Nav ---- */
            nav.site-nav {
                background-color: var(--parchment-deep);
                border-bottom: 1px solid var(--parchment-line);
            }
            .brand-mark svg { width: 30px; height: 30px; }
            .brand-name {
                font-family: 'Fraunces', serif;
                font-weight: 600;
                font-size: 1.2rem;
                letter-spacing: 0.01em;
                color: var(--walnut);
            }
            .nav-link {
                font-family: 'Inter', sans-serif;
                font-size: 0.82rem;
                font-weight: 500;
                letter-spacing: 0.02em;
                color: var(--walnut-soft);
                border-bottom: 1px solid transparent;
                padding-bottom: 2px;
                transition: color 0.15s ease, border-color 0.15s ease;
            }
            .nav-link:hover { color: var(--walnut); border-color: var(--brass); }
            .btn-ghost {
                font-family: 'Inter', sans-serif;
                font-size: 0.82rem;
                font-weight: 600;
                color: var(--walnut-soft);
                transition: color 0.15s ease;
            }
            .btn-ghost:hover { color: var(--walnut); }
            .btn-outline {
                font-family: 'Inter', sans-serif;
                font-size: 0.82rem;
                font-weight: 600;
                letter-spacing: 0.02em;
                color: var(--walnut);
                border: 1px solid var(--walnut);
                padding: 0.55rem 1.1rem;
                border-radius: 2px;
                transition: background-color 0.15s ease, color 0.15s ease;
                display: inline-block;
            }
            .btn-outline:hover { background-color: var(--walnut); color: var(--parchment); }
            .hamburger-icon { width: 20px; height: 14px; position: relative; }
            .hamburger-icon span { position: absolute; left: 0; width: 100%; height: 1.5px; background: var(--walnut); }
            .hamburger-icon span:nth-child(1) { top: 0; }
            .hamburger-icon span:nth-child(2) { top: 6px; }
            .hamburger-icon span:nth-child(3) { top: 12px; }

            /* ---- Auth card ---- */
            .auth-card {
                display: grid;
                grid-template-columns: 0.85fr 1.15fr;
                background: var(--parchment-deep);
                border: 1px solid var(--parchment-line);
                box-shadow: 0 24px 48px -24px rgba(33, 21, 8, 0.45);
                position: relative;
                overflow: hidden;
                width: 100%;
                max-width: 780px;
            }
            .auth-card::before {
                content: "";
                position: absolute;
                inset: 8px;
                border: 1px solid rgba(169,129,44,0.35);
                pointer-events: none;
                z-index: 1;
            }

            .panel-illustration {
                background: linear-gradient(160deg, #2C2018 0%, #3B2A1E 55%, #4A3624 100%);
                position: relative;
                padding: 2.25rem 1.5rem;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                color: var(--parchment);
                overflow: hidden;
            }
            .panel-illustration::after {
                content: "";
                position: absolute;
                inset: 0;
                background-image: repeating-linear-gradient(115deg, rgba(255,255,255,0.025) 0px, rgba(255,255,255,0.025) 1px, transparent 1px, transparent 5px);
                pointer-events: none;
            }
            .eyebrow-vertical {
                writing-mode: vertical-rl;
                transform: rotate(180deg);
                font-family: 'Inter', sans-serif;
                font-size: 0.66rem;
                letter-spacing: 0.26em;
                font-weight: 600;
                color: var(--brass-bright);
                text-transform: uppercase;
                z-index: 1;
                margin: 0 auto;
            }
            .knight-figure { position: relative; z-index: 1; margin: 1rem auto; width: 92px; }
            .knight-figure svg { width: 100%; height: auto; display: block; }
            .panel-illustration .caption {
                font-family: 'Fraunces', serif;
                font-style: italic;
                font-size: 0.85rem;
                color: rgba(242,232,208,0.55);
                text-align: center;
                z-index: 1;
                line-height: 1.4;
            }

            /* ---- Form side ---- */
            .panel-auth { background: var(--parchment); position: relative; z-index: 1; }

            .tab-row { display: flex; border-bottom: 1px solid var(--parchment-line); }
            .tab-btn {
                flex: 1;
                padding: 1.1rem 1.5rem;
                text-align: center;
                font-family: 'Inter', sans-serif;
                font-size: 0.82rem;
                font-weight: 600;
                letter-spacing: 0.04em;
                text-transform: uppercase;
                background: none;
                cursor: pointer;
                border: none;
                border-bottom: 2px solid transparent;
                transition: color 0.15s ease, border-color 0.15s ease;
            }
            .tab-color-active { color: var(--walnut); }
            .tab-border-active { border-bottom-color: var(--brass); }
            .tab-color-inactive { color: var(--walnut-soft); }
            .tab-btn:hover { color: var(--walnut); }

            .auth-form-wrap { padding: 2.25rem 2.25rem 2rem; }

            label {
                display: block;
                font-family: 'Inter', sans-serif;
                font-size: 0.72rem;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--walnut-soft);
                margin-bottom: 0.5rem;
            }
            .input-field {
                width: 100%;
                padding: 0.75rem 0.9rem;
                background: var(--parchment);
                border: 1px solid var(--parchment-line);
                border-radius: 2px;
                color: var(--ink);
                font-family: 'Spectral', serif;
                font-size: 0.96rem;
            }
            .input-field::placeholder { color: rgba(110, 86, 67, 0.55); }
            .input-field:focus {
                outline: none;
                border-color: var(--brass);
                box-shadow: 0 0 0 3px rgba(169, 129, 44, 0.22);
            }

            .btn-primary {
                width: 100%;
                font-family: 'Inter', sans-serif;
                font-size: 0.85rem;
                font-weight: 600;
                letter-spacing: 0.03em;
                cursor: pointer;
                padding: 0.85rem 1rem;
                border-radius: 2px;
                border: 1px solid var(--walnut);
                background: var(--walnut);
                color: var(--parchment);
                transition: background-color 0.15s ease, color 0.15s ease;
            }
            .btn-primary:hover { background: transparent; color: var(--walnut); }
            .btn-primary:focus-visible { outline: 2px solid var(--brass); outline-offset: 2px; }

            .recovery-note {
                margin-top: 1.5rem;
                text-align: center;
                font-family: 'Inter', sans-serif;
                font-size: 0.82rem;
                color: var(--walnut-soft);
            }
            .recovery-note a, .recovery-note button {
                background: none;
                border: none;
                cursor: pointer;
                color: var(--walnut);
                font-weight: 600;
                font-family: inherit;
                font-size: inherit;
                border-bottom: 1px solid var(--brass);
                padding: 0;
            }
            .recovery-note a:hover, .recovery-note button:hover { color: var(--brass); }

            /* ---- Footer ---- */
            footer.site-footer { background-color: var(--walnut); color: var(--parchment); border-top: 1px solid var(--brass); }
            footer .footer-heading {
                font-family: 'Inter', sans-serif;
                font-size: 0.72rem;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                color: var(--brass-bright);
            }
            footer a.footer-link {
                color: rgba(242,232,208,0.75);
                font-family: 'Spectral', serif;
                font-size: 0.92rem;
                transition: color 0.15s ease;
            }
            footer a.footer-link:hover { color: var(--brass-bright); }
            footer .brand-blurb { color: rgba(242,232,208,0.65); font-family: 'Spectral', serif; font-size: 0.92rem; max-width: 32ch; }
            .social-mark {
                font-family: 'Inter', sans-serif;
                font-size: 0.72rem;
                letter-spacing: 0.08em;
                color: rgba(242,232,208,0.6);
                border: 1px solid rgba(242,232,208,0.25);
                padding: 0.3rem 0.55rem;
                transition: border-color 0.15s ease, color 0.15s ease;
            }
            .social-mark:hover { border-color: var(--brass-bright); color: var(--brass-bright); }

            @media (max-width: 640px) {
                .auth-card { grid-template-columns: 1fr; }
                .panel-illustration { flex-direction: row; justify-content: center; gap: 1rem; padding: 1.25rem; }
                .eyebrow-vertical { writing-mode: horizontal-tb; transform: none; margin: 0; }
                .knight-figure { width: 52px; margin: 0; }
                .panel-illustration .caption { display: none; }
                .auth-form-wrap { padding: 1.75rem 1.5rem; }
            }
        </style>
    </head>

    <body class="min-h-screen flex flex-col">
        <!-- Navigation -->
        <nav class="site-nav py-4 px-6 sticky top-0 z-50">
            <div class="max-w-7xl mx-auto flex justify-between items-center">
