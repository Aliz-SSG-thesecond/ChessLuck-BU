                              fill="none" stroke="#3B2A1E" stroke-width="1.3" stroke-linejoin="round"/>
                        <rect x="8" y="27" width="14" height="2.2" fill="none" stroke="#3B2A1E" stroke-width="1.3"/>
                    </svg>
                    <span class="brand-name"><a href="http://localhost:5000/">ChessMaster</a></span>
                </div>

                <div class="hidden md:flex space-x-8">
                    <a href="http://localhost:5000/" class="nav-link">Home</a>
                    <a href="http://localhost:5000/learn" class="nav-link">Puzzles</a>
                    <a href="http://localhost:5000/learn" class="nav-link">Learn</a>
                </div>

                <div class="flex items-center space-x-5">
                    <button class="btn-ghost hidden md:block"><a href="http://localhost:5000/login">Sign up</a></button>
                    <button class="btn-outline"><a href="http://localhost:5000/login">Log In</a></button>
                    <button class="md:hidden text-xl" aria-label="Open menu">
                        <span class="hamburger-icon"><span></span><span></span><span></span></span>
                    </button>
                </div>
            </div>
        </nav>

        <!-- Auth Forms Section -->
        <section class="flex-grow flex items-center justify-center p-6">
            <div class="auth-card">

                <!-- Left: illustration -->
                <div class="panel-illustration">
                    <div class="eyebrow-vertical">Welcome &middot; Back</div>
                    <div class="knight-figure" aria-hidden="true">
                        <svg viewBox="0 0 100 130" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <pattern id="hatch4" width="4" height="4" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
                                    <line x1="0" y1="0" x2="0" y2="4" stroke="#C9A227" stroke-width="0.6" opacity="0.55"/>
                                </pattern>
                            </defs>
                            <path d="M30 122 L28 108 Q26 96 34 88 L34 82 Q22 78 22 64 Q22 50 34 42 Q32 34 40 26 Q46 18 58 18 Q70 18 74 30 Q78 40 70 46 Q78 52 76 62 L86 74 Q90 78 86 84 L74 86 L70 122 Z"
                                fill="url(#hatch4)" stroke="#F2E8D0" stroke-width="1.4" stroke-linejoin="round"/>
                            <path d="M30 122 L28 108 Q26 96 34 88 L34 82 Q22 78 22 64 Q22 50 34 42 Q32 34 40 26 Q46 18 58 18 Q70 18 74 30 Q78 40 70 46 Q78 52 76 62 L86 74 Q90 78 86 84 L74 86 L70 122 Z"
                                fill="none" stroke="#F2E8D0" stroke-width="1.6" stroke-linejoin="round"/>
                            <circle cx="52" cy="34" r="2" fill="#F2E8D0"/>
                            <rect x="18" y="120" width="56" height="6" fill="none" stroke="#F2E8D0" stroke-width="1.4"/>
                        </svg>
                    </div>
                    <p class="caption">The board is set.<br/>Take your seat.</p>
                </div>

                <!-- Right: tabs + forms -->
                <div class="panel-auth">
                    <!-- Tabs -->
                    <div class="tab-row">
                        <button id="login-tab" class="tab-btn tab-color-active tab-border-active">
                            Login
                        </button>
                        <button id="signup-tab" class="tab-btn tab-color-inactive">
                            SignUp
                        </button>
                    </div>

                    <!-- Login Form -->
                    <div id="login-form" class="auth-form-wrap">
                        <form action="/auth/login" method="POST">

                            <div class="mb-5">
                                <label for="login-username">Username</label>
                                <input type="text" id="login-username" name="username"
                                    class="input-field"
                                    placeholder="username" required>
                            </div>
                            <div class="mb-6">
                                <label for="login-password">Password</label>
                                <input type="password" id="login-password" name="password"
                                    class="input-field"
                                    placeholder="••••••••" required>
                            </div>
                            <button type="submit" class="btn-primary">
                                LogIn
                            </button>
                        </form>
                        <div class="recovery-note">
                            Forgot your password? <button id="recovery"><a href="/auth/recovery">Recover password</a></button>
                        </div>
                    </div>

                    <!-- Signup Form (hidden by default) -->
                    <form action="/auth/signup" method="POST">
                        <div id="signup-form" class="auth-form-wrap hidden">

                            <div class="mb-5">
                                <label for="signup-username">Username</label>
                                <input type="text" id="signup-username" name="username"
                                    class="input-field"
                                    placeholder="username" required>
                            </div>
                            <div class="mb-5">
                                <label for="signup-email">Email Address</label>
                                <input type="text" id="signup-email" name="email"
                                    class="input-field"
                                    placeholder="*****@*****.com" required>
                            </div>
                            <div class="mb-6">
                                <label for="signup-password">Password</label>
                                <input type="password" id="signup-password" name="password"
                                    class="input-field"
                                    placeholder="••••••••" required>
                            </div>
                            <button type="submit" class="btn-primary">
                                Create Account
                            </button>
                    </form>
                    <!-- <div class="mt-6 text-center text-sm text-gray-400">
                        forgot your password? <button id="switch-to-login" class="text-blue-400 hover:underline">recover password</button>
                    </div>
                </div>
                </div> -->
            </div>
        </section>

        <!-- Footer -->
        <footer class="site-footer py-12">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid md:grid-cols-4 gap-10">
                    <div>
                        <div class="flex items-center space-x-2 mb-4">
                            <svg viewBox="0 0 32 32" width="24" height="24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M10 27 L9 22 Q8.5 19 11 17 L11 15 Q6 13.5 6 10.5 Q6 7.5 10.5 6.5 Q10 4.5 12.5 3.2 Q15 2 18 3 Q20.5 3.8 20.5 6.2 Q20.5 8 18.5 9 Q21 10 20.5 12.5 L24 16 Q25 17 24 18.5 L20.5 19 L19.5 27 Z"
                                      fill="none" stroke="#C9A227" stroke-width="1.3" stroke-linejoin="round"/>
                                <rect x="8" y="27" width="14" height="2.2" fill="none" stroke="#C9A227" stroke-width="1.3"/>
                            </svg>
                            <span class="font-display font-semibold text-lg">ChessMaster</span>
                        </div>
                        <p class="brand-blurb">A quieter place to play. Rated games, real lessons, and a
                            board that stays out of the way.</p>
                        <div class="flex space-x-2 mt-6">
                            <a href="http://localhost:5000/about" class="social-mark">X</a>
                            <a href="http://localhost:5000/about" class="social-mark">FB</a>
                            <a href="http://localhost:5000/about" class="social-mark">IG</a>
                            <a href="http://localhost:5000/about" class="social-mark">YT</a>
                        </div>
                    </div>

                    <div>
                        <h3 class="footer-heading mb-4">Play</h3>
                        <ul class="space-y-2">
                            <li><a href="http://localhost:5000/play" class="footer-link">Live Chess</a></li>
                            <li><a href="http://localhost:5000/learn" class="footer-link">Computer</a></li>
                            <li><a href="http://localhost:5000/friends" class="footer-link">Friends</a></li>
                            <li><a href="http://localhost:5000/learn" class="footer-link">Tournaments</a></li>
                            <li><a href="http://localhost:5000/learn" class="footer-link">Variants</a></li>
                        </ul>
                    </div>

                    <div>
                        <h3 class="footer-heading mb-4">Learn</h3>
                        <ul class="space-y-2">
                            <li><a href="http://localhost:5000/learn" class="footer-link">Lessons</a></li>
                            <li><a href="http://localhost:5000/learn" class="footer-link">Puzzles</a></li>
                            <li><a href="http://localhost:5000/learn" class="footer-link">Practice</a></li>
                            <li><a href="http://localhost:5000/learn" class="footer-link">Analysis</a></li>
                            <li><a href="http://localhost:5000/learn" class="footer-link">Opening Explorer</a></li>
                        </ul>
                    </div>

                    <div>
                        <h3 class="footer-heading mb-4">Company</h3>
                        <ul class="space-y-2">
                            <li><a href="http://localhost:5000/about" class="footer-link">About</a></li>
                            <li><a href="http://localhost:5000/about" class="footer-link">Careers</a></li>
                            <li><a href="http://localhost:5000/about" class="footer-link">Blog</a></li>
                            <li><a href="http://localhost:5000/about" class="footer-link">Help</a></li>
                            <li><a href="http://localhost:5000/about" class="footer-link">Contact</a></li>
                        </ul>
                    </div>
                </div>

                <div class="mt-12 pt-8 flex flex-col md:flex-row justify-between items-center" style="border-top: 1px solid rgba(242,232,208,0.15);">
                    <p class="text-sm mb-4 md:mb-0" style="color: rgba(242,232,208,0.5);">© 2026 ChessMaster. All rights reserved.</p>
                    <div class="flex space-x-6">
                        <a href="http://localhost:5000/about" class="text-sm footer-link">Privacy Policy</a>
                        <a href="http://localhost:5000/about" class="text-sm footer-link">Terms of Service</a>
                        <a href="http://localhost:5000/about" class="text-sm footer-link">Cookies</a>
                    </div>
                </div>
            </div>
        </footer>

        <script>
            // Simple animation for chess pieces
            document.addEventListener('DOMContentLoaded', function () {
                const pieces = document.querySelectorAll('.piece-hover');

                pieces.forEach(piece => {
                    piece.addEventListener('mouseenter', function () {
                        this.classList.add('animate-bounce');
                    });

                    piece.addEventListener('mouseleave', function () {
                        this.classList.remove('animate-bounce');
                    });
                });

                // Mobile menu toggle would go here
                const mobileMenuButton = document.querySelector('.md\\:hidden.text-xl');
                mobileMenuButton.addEventListener('click', function () {
                    alert('Mobile menu would open here in a full implementation');
                });

                // Form tab switching
                const loginTab = document.getElementById('login-tab');
                const signupTab = document.getElementById('signup-tab');
                const loginForm = document.getElementById('login-form');
                const signupForm = document.getElementById('signup-form');
                const switchToSignup = document.getElementById('switch-to-signup');
                const switchToLogin = document.getElementById('switch-to-login');

                function showLogin() {
                    loginTab.classList.add('tab-color-active', 'tab-border-active');
                    loginTab.classList.remove('tab-color-inactive');
                    signupTab.classList.add('tab-color-inactive');
                    signupTab.classList.remove('tab-color-active', 'tab-border-active');
                    loginForm.classList.remove('hidden');
                    signupForm.classList.add('hidden');
                }

                function showSignup() {
                    signupTab.classList.add('tab-color-active', 'tab-border-active');
                    signupTab.classList.remove('tab-color-inactive');
                    loginTab.classList.add('tab-color-inactive');
                    loginTab.classList.remove('tab-color-active', 'tab-border-active');
                    signupForm.classList.remove('hidden');
                    loginForm.classList.add('hidden');
                }

                loginTab.addEventListener('click', showLogin);
                signupTab.addEventListener('click', showSignup);
                switchToSignup.addEventListener('click', showSignup);
                switchToLogin.addEventListener('click', showLogin);
            });
        </script>
    </body>

</html>
